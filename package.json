{
  "name": "@local/dsh-mcp-manager",
  "version": "1.3.1",
  "private": true,
  "type": "module",
  "description": "MCP 管理器：发现、添加、启用、禁用并查看本机所有 MCP 服务器及其工具（中文界面，可切换英文）",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "INSTALL.md",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": false
    }
  }
}
